{
    "name":  "routine-taskboard",
    "version":  "0.1.9",
    "type":  "module",
    "description":  "Routine taskboard for DSH: a dedicated registry of long-lived scheduled infrastructure placards (windows tasks / cron / ai sessions) with dual-source health lamps and artifact freshness, plus a lightweight claimable work-order board.",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "engines":  {
                                "dsh":  "\u003e=0.1.1-rc.1"
                            },
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [

                                          ],
                               "external":  [
                                                "react",
                                                "react/jsx-runtime",
                                                "react-dom/client"
                                            ],
                               "platform":  "web"
                           }
            },
    "files":  [
                  "lib/**/*.js",
                  "cordis.patch.yml",
                  "LICENSE",
                  "README.md"
              ],
    "license":  "MIT",
    "author":  "Amoss-1",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Amoss-1/routine-taskboard.git"
                   },
    "homepage":  "https://github.com/Amoss-1/routine-taskboard#readme",
    "keywords":  [
                     "deepseek",
                     "harness",
                     "dsh",
                     "dsh-plugin",
                     "taskboard",
                     "scheduler",
                     "kanban"
                 ]
}